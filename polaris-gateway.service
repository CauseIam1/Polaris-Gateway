[Unit]
Description=FreeRoam Polaris Gateway Service
After=network.target wireguard@wg0.service
Wants=wireguard@wg0.service

[Service]
Type=simple
User=causeiam
Group=causeiam
WorkingDirectory=/home/causeiam/docker-containers/freeroam/polaris-gateway
Environment="FREEROAM_DATA_DIR=/home/causeiam/docker-containers/freeroam/data"
Environment="OLLAMA_HOST=http://127.0.0.1:11434"
Environment="BURST_STORAGE_DIR=/home/causeiam/docker-containers/freeroam/data/bursts"
Environment="TELEMETRY_LOG=/home/causeiam/docker-containers/freeroam/data/telemetry.log"
ExecStart=/usr/bin/python3 /home/causeiam/docker-containers/freeroam/polaris-gateway/polaris_gateway.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=polaris-gateway

# Security hardening (relaxed for standalone deployment)
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target